# Copy to backend/.env and fill in only what you use. Never commit the real .env.

# ---- Database (SQLite by default; PostgreSQL works by changing the URL) ----
# DATABASE_URL=sqlite:///./data/jobpilot.db
# DATABASE_URL=postgresql+psycopg://jobpilot:password@localhost:5432/jobpilot

# ---- Frontend origin(s) allowed to call the API ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Background search scheduler (runs search profiles with "auto run" on) ----
SCHEDULER_ENABLED=true

# ---- AI (optional). none | openai | anthropic | ollama ----
AI_PROVIDER=none

# OpenAI or any OpenAI-compatible API (Groq, Together, OpenRouter, LM Studio, vLLM ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# Ollama (free, local): install from ollama.com, then `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Job source credentials (optional) ----
# Adzuna: free key at https://developer.adzuna.com (best official source for India)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
